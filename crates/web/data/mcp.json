            "default": 50,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "search": {
            "description": "Case-insensitive card id/title search",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
