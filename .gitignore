.DS_Store

# Xcode user state and local build output
ios/DerivedData/
ios/build/
ios/.build/
ios/.swiftpm/
ios/**/*.xcuserstate
ios/**/xcuserdata/

# Maintainer-only files
/docs/
/tools/
/NACHT-12-08.md
plugins/*/PORTED.md

# Local binaries and test output
/hopy
/stulp
/com.stulp.*
/matter
plugins/*/com.*
examples/*/com.*
/*.test
/coverage.out
/_appbuild-*
# An app built into the repository root instead of next to its app.json.
/unifi
/notify

# HopOS images generated by ./build.sh hopos
/out/

# Runtime state
/*.db
/*.db-shm
/*.db-wal
/*.db.apps/
/stulp.json
/*.json.apps/
/*.db.pre-migration
# Stulp can also run from an app directory, so these are not root-anchored.
*.log
keten.json
keten.json.apps/
