            "description": "Skip cards whose app is not running",
            "type": "boolean"
          },
          "cardId": {
            "description": "One exact card id, with its argument and token definitions",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "deviceId": {
            "description": "Only cards usable with this device, plus global cards",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "trigger",
              "condition",
              "action"
            ],
            "type": "string"
