{
  "id": "com.stulp.notify",
  "version": "1.0.0",
  "sdk": 3,
  "compatibility": ">=1.0.0",
  "name": { "en": "Notifications", "nl": "Meldingen" },
  "description": {
    "en": "Your phone with the Stulp app as a device, so a Flow can send a notification to it",
    "nl": "Je telefoon met de Stulp-app als apparaat, zodat een Flow er een melding naartoe kan sturen"
  },
  "author": { "name": "Stulp" },
  "category": ["tools"],
  "capabilities": {
    "charging": {
      "type": "boolean",
      "title": {
        "en": "On the charger",
        "nl": "Aan de lader"
      },
      "getable": true,
      "setable": false
    },
    "home": {
      "type": "boolean",
      "title": {
        "en": "Home",
        "nl": "Thuis"
      },
      "getable": true,
      "setable": false
    }
  },
  "drivers": [
    {
      "id": "phone",
      "name": { "en": "Phone", "nl": "Telefoon" },
      "class": "phone",
      "capabilities": ["onoff", "charging", "home"],
      "capabilitiesOptions": {
        "onoff": { "title": { "en": "Notifications", "nl": "Meldingen" } }
      }
    }
  ],
  "flow": {
    "actions": [
      {
        "id": "send",
        "title": { "en": "Send a notification", "nl": "Stuur een melding" },
        "titleFormatted": {
          "en": "Send [[message]] to [[device]]",
          "nl": "Stuur [[message]] naar [[device]]"
        },
        "hint": {
          "en": "Arrives through the Stulp app on that phone, also when the app is closed. A picture is optional and comes from a camera that offers one; tapping it opens that camera.",
          "nl": "Komt via de Stulp-app op die telefoon aan, ook als de app dicht is. Een foto is optioneel en komt van een camera die er een levert; tikken opent die camera."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=phone"
          },
          {
            "name": "title",
            "type": "text",
            "title": { "en": "Heading", "nl": "Kop" },
            "placeholder": { "en": "Stulp", "nl": "Stulp" },
            "optional": true
          },
          {
            "name": "message",
            "type": "text",
            "title": { "en": "Message", "nl": "Bericht" },
            "placeholder": { "en": "Someone is at the door", "nl": "Iemand belt aan" }
          },
          {
            "name": "level",
            "type": "dropdown",
            "title": { "en": "Urgency", "nl": "Hoe dringend" },
            "optional": true,
            "values": [
              { "id": "active", "label": { "en": "Normal", "nl": "Gewoon" } },
              { "id": "time-sensitive", "label": { "en": "Urgent, through Focus", "nl": "Dringend, door Focus heen" } },
              { "id": "critical", "label": { "en": "Critical, also when silenced", "nl": "Kritiek, ook als hij op stil staat" } }
            ]
          },
          {
            "name": "image",
            "type": "autocomplete",
            "title": { "en": "Picture", "nl": "Foto" },
            "placeholder": { "en": "No picture", "nl": "Geen foto" },
            "optional": true
          }
        ]
      }
    ]
  },
  "api": {
    "test": { "method": "POST", "path": "/test" },
    "report": { "method": "POST", "path": "/report" },
    "register_push": { "method": "POST", "path": "/register_push" }
  }
}
